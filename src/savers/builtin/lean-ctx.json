{
  "id": "lean-ctx",
  "name": "lean-ctx",
  "repo": "https://github.com/yvgude/lean-ctx",
  "version": "3.10.3",
  "licence": "Apache-2.0",
  "method": "replayed",
  "covers": "shell output and file reads, by its shell and read pipelines",
  "assumption": "lean-ctx reports its own before/after token counts (its offline `compress diff` preview), and that ratio is applied to saver-audit's count of the same output; run with default settings. Outputs under 500 tokens are not replayed; on the author's logs that left out about 1% of its savings",
  "stage": "tool",
  "binary": "lean-ctx",
  "binaryEnv": "SAVER_AUDIT_LEAN_CTX",
  "versionArgs": [
    "--version"
  ],
  "env": {
    "HOME": "{state}/lean-ctx-home",
    "USERPROFILE": "{state}/lean-ctx-home",
    "APPDATA": "{state}/lean-ctx-home/AppData/Roaming",
    "LOCALAPPDATA": "{state}/lean-ctx-home/AppData/Local",
    "XDG_CONFIG_HOME": "{state}/lean-ctx-home/.config",
    "XDG_DATA_HOME": "{state}/lean-ctx-home/.local/share",
    "XDG_STATE_HOME": "{state}/lean-ctx-home/.local/state",
    "XDG_CACHE_HOME": "{state}/lean-ctx-home/.cache"
  },
  "jsonRatio": {
    "before": "original_tokens",
    "after": "compressed_tokens",
    "afterBytes": "compressed_bytes"
  },
  "routes": [
    {
      "name": "shell",
      "match": {
        "categories": [
          "Shell"
        ]
      },
      "args": [
        "compress",
        "diff",
        "-",
        "--shell",
        "{command}",
        "--json"
      ]
    },
    {
      "name": "read",
      "match": {
        "categories": [
          "File reads"
        ]
      },
      "args": [
        "compress",
        "diff",
        "-",
        "--json"
      ]
    }
  ],
  "minTokens": 500,
  "codexHypothetical": true,
  "install": "npx saver-audit --install-savers"
}
