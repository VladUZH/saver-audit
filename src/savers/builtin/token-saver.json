{
  "id": "token-saver",
  "name": "token-saver",
  "repo": "https://github.com/ppgranger/token-saver",
  "version": "3.0.0",
  "licence": "Apache-2.0",
  "method": "replayed",
  "covers": "shell output, by its 36 command-aware processors",
  "assumption": "run with default settings and without the exit code (the logs do not keep it), so failure-aware routing is not used. Outputs under 500 tokens are not replayed; on the author's logs that left out about 9% of its savings, so this is slightly low",
  "stage": "tool",
  "binary": "token-saver",
  "binaryEnv": "SAVER_AUDIT_TOKEN_SAVER",
  "versionArgs": [
    "version"
  ],
  "env": {
    "HOME": "{state}/token-saver-home",
    "USERPROFILE": "{state}/token-saver-home",
    "APPDATA": "{state}/token-saver-home/AppData/Roaming",
    "LOCALAPPDATA": "{state}/token-saver-home/AppData/Local",
    "XDG_CONFIG_HOME": "{state}/token-saver-home/.config",
    "XDG_DATA_HOME": "{state}/token-saver-home/.local/share",
    "XDG_STATE_HOME": "{state}/token-saver-home/.local/state",
    "XDG_CACHE_HOME": "{state}/token-saver-home/.cache"
  },
  "routes": [
    {
      "name": "shell",
      "match": {
        "categories": [
          "Shell"
        ]
      },
      "args": [
        "compress",
        "{command}"
      ]
    }
  ],
  "minTokens": 500,
  "codexHypothetical": true,
  "install": "npx saver-audit --install-savers"
}
